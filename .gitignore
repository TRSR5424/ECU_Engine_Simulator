# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Vim / Emacs swap files
*~
*.swp

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
pip-log.txt
pip-delete-this-directory.txt
pyenv-virtualenv.cfg
build/
dist/
eggs/
*.egg-info/
*.egg
wheelhouse/
htmlcov/
.tox/
.nox/
.pytest_cache/
coverage.xml
.coverage
cover/

# Jupyter
.ipynb_checkpoints

# C / C++ build
*.o
*.obj
*.so
*.a
*.lib
*.dll
*.exe
*.out
*.dSYM/
cmake-build-*/
*.exp

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# IDEs/Editors
.idea/
.vscode/
/.history/
*.iml

# Logs and runtime files
*.log
*.log.*
*.pid
*.seed
*.pid.lock
/data

# Environment variables
.env
.env.*.local

# Data files and runs (keep under version control only if needed)
/data/runs/
/data/logs/

# Generated config (runtime)
/config/active/resolved_config.yaml

# macOS
Icon

# Coverage, profiling
*.prof
coverage/

# Misc
.cache/
.pytest_cache/
.mypy_cache/
__MACOSX/

/config/active/
# ignore user global file
/config/global.yaml
# ignore all experiment subfolders inside config, but allow `base/` and the example
/config/*/
!/config/base/
!/config/global.yaml.example

# Rust
# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/